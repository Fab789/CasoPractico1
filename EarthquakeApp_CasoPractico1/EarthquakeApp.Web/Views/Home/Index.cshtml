@model SearchViewModel
@{
    ViewData["Title"] = "Inicio";
}
<main id="page" class="page">
    <section class="hero">
        <div class="logo" aria-hidden="true">🌎</div>
        <h1>Buscador de <span>Terremotos</span></h1>
        <p class="tagline">Escribe el nombre de un país y descubre los sismos registrados desde 2020.</p>

        <form id="searchForm" class="search-form" novalidate>
            <div class="search-bar">
                <span class="icon" aria-hidden="true">🔍</span>
                <input id="countryInput" name="country" type="search" maxlength="100"
                       autocomplete="off" placeholder="Ej: Chile, Japón, Costa Rica..."
                       aria-label="Nombre del país" autofocus />
                <button type="submit" id="searchBtn">Buscar</button>
            </div>
        </form>
    </section>

    <div id="loader" class="loader" hidden><div class="spinner"></div><span>Buscando...</span></div>
    <div id="results" class="results"></div>
</main>
