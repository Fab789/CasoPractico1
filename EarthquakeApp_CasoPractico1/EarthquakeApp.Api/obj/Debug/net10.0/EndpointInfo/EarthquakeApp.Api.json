{
  "openapi": "3.0.1",
  "info": {
    "title": "EarthquakeApp.Api",
    "version": "1.0"
  },
  "paths": {
    "/api/Earthquakes/search": {
      "get": {
        "tags": [
          "Earthquakes"
        ],
        "parameters": [
          {
            "name": "country",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/EarthquakeSearchResultDto"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EarthquakeSearchResultDto"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/EarthquakeSearchResultDto"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/Earthquakes/refresh": {
      "post": {
        "tags": [
          "Earthquakes"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CountryDto": {
        "type": "object",
        "properties": {
          "commonName": {
            "type": "string",
            "nullable": true
          },
          "officialName": {
            "type": "string",
            "nullable": true
          },
          "cca2": {
            "type": "string",
            "nullable": true
          },
          "capital": {
            "type": "string",
            "nullable": true
          },
          "region": {
            "type": "string",
            "nullable": true
          },
          "subregion": {
            "type": "string",
            "nullable": true
          },
          "population": {
            "type": "integer",
            "format": "int64"
          },
          "area": {
            "type": "number",
            "format": "double"
          },
          "flagUrl": {
            "type": "string",
            "nullable": true
          },
          "languages": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "nullable": true
          },
          "currencies": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "nullable": true
          },
          "timezones": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "EarthquakeDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "usgsId": {
            "type": "string",
            "nullable": true
          },
          "magnitude": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "place": {
            "type": "string",
            "nullable": true
          },
          "country": {
            "type": "string",
            "nullable": true
          },
          "timeUtc": {
            "type": "string",
            "format": "date-time"
          },
          "latitude": {
            "type": "number",
            "format": "double"
          },
          "longitude": {
            "type": "number",
            "format": "double"
          },
          "depthKm": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "url": {
            "type": "string",
            "nullable": true
          },
          "title": {
            "type": "string",
            "nullable": true
          },
          "type": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "EarthquakeSearchResultDto": {
        "type": "object",
        "properties": {
          "searchedCountry": {
            "type": "string",
            "nullable": true
          },
          "country": {
            "$ref": "#/components/schemas/CountryDto"
          },
          "totalEarthquakes": {
            "type": "integer",
            "format": "int32"
          },
          "maxMagnitude": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "averageMagnitude": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "earthquakes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EarthquakeDto"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ErrorResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "integer",
            "format": "int32"
          },
          "message": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    }
  }
}